<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Teleprompter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Teleprompter.ViewModels"
    x:DataType="viewModels:SettingsViewModel"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <Label
                Text="Global defaults"
                Style="{StaticResource SectionTitle}" />

            <!-- Speed -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="Speed" VerticalOptions="Center" FontAttributes="Bold" />
                <Slider
                    Grid.Column="1"
                    Value="{Binding Speed}"
                    Minimum="10"
                    Maximum="150"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="2"
                    Style="{StaticResource Caption}"
                    Text="{Binding SpeedText}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Font Size -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="Font size" VerticalOptions="Center" FontAttributes="Bold" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button
                        Style="{StaticResource SmallIconButton}"
                        Text="-"
                        Command="{Binding DecreaseFontCommand}"
                        SemanticProperties.Description="Decrease font size" />
                    <Button
                        Style="{StaticResource SmallIconButton}"
                        Text="+"
                        Command="{Binding IncreaseFontCommand}"
                        SemanticProperties.Description="Increase font size" />
                </HorizontalStackLayout>
                <Label
                    Grid.Column="2"
                    Style="{StaticResource Caption}"
                    Text="{Binding FontSizeText}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Mirror -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                <Label Text="Mirror mode" VerticalOptions="Center" />
                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding MirrorMode}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Highlight Toggle -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                <Label Text="Highlight words" VerticalOptions="Center" />
                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding HighlightEnabled}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Highlight Speed -->
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10"
                IsVisible="{Binding HighlightEnabled}">
                <Label Text="Highlight speed" VerticalOptions="Center" FontAttributes="Bold" />
                <Slider
                    Grid.Column="1"
                    Value="{Binding HighlightWpm}"
                    Minimum="60"
                    Maximum="300"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="2"
                    Style="{StaticResource Caption}"
                    Text="{Binding HighlightWpmText}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Highlight Color -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HighlightEnabled}">
                <Label Text="Highlight color" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFFF00" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#FFFF00" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#00FF00" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#00FF00" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#00FFFF" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#00FFFF" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFA500" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#FFA500" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FF00FF" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#FF00FF" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FF0000" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#FF0000" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFFFFF" Command="{Binding SelectHighlightColorCommand}" CommandParameter="#FFFFFF" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Text Color -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Text color" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#000000" Command="{Binding SelectTextColorCommand}" CommandParameter="#000000" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFFFFF" Command="{Binding SelectTextColorCommand}" CommandParameter="#FFFFFF" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFFF00" Command="{Binding SelectTextColorCommand}" CommandParameter="#FFFF00" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#00FF00" Command="{Binding SelectTextColorCommand}" CommandParameter="#00FF00" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Background Color -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Background" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#000000" Command="{Binding SelectBackgroundColorCommand}" CommandParameter="#000000" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#FFFFFF" Command="{Binding SelectBackgroundColorCommand}" CommandParameter="#FFFFFF" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#004400" Command="{Binding SelectBackgroundColorCommand}" CommandParameter="#004400" />
                    <Button Style="{StaticResource ColorButton}" BackgroundColor="#222222" Command="{Binding SelectBackgroundColorCommand}" CommandParameter="#222222" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Theme -->
            <Label
                Text="Theme"
                Style="{StaticResource SectionTitle}"
                Margin="0,8,0,0" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    Text="System"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="System" />
                <Button
                    Grid.Column="1"
                    Text="Light"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="Light" />
                <Button
                    Grid.Column="2"
                    Text="Dark"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="Dark" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
