<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Teleprompter.Views.ScriptListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Teleprompter.Models"
    xmlns:viewModels="clr-namespace:Teleprompter.ViewModels"
    x:DataType="viewModels:ScriptListViewModel"
    Title="Scripts">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Import"
            IconImageSource="import_file.png"
            Command="{Binding ImportScriptCommand}"
            SemanticProperties.Description="Import script from file" />
        <ToolbarItem
            Text="Settings"
            IconImageSource="settings.png"
            Command="{Binding OpenSettingsCommand}"
            SemanticProperties.Description="Open settings" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <Border
            IsVisible="{Binding HasSession}"
            Margin="0,0,0,8"
            Padding="14,10"
            BackgroundColor="{StaticResource Tertiary}"
            StrokeShape="RoundRectangle 12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label
                        Text="Resume last session"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White" />
                    <Label
                        Text="{Binding SessionTitle}"
                        FontSize="12"
                        TextColor="White"
                        LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource NoBorderButton}"
                    ImageSource="play.png"
                    TextColor="White"
                    WidthRequest="40"
                    HeightRequest="40"
                    Command="{Binding ResumeSessionCommand}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Scripts}"
            SelectionMode="None"
            Margin="0,4,0,80">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="30"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        Text="No scripts yet"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Tap + to create your first script."
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ScriptModel">
                        <Border
                            Margin="0"
                            Padding="14,12"
                            StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ScriptListViewModel}}, Path=OpenScriptCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="2">
                                <Label
                                    Text="{Binding Title}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding WordCount, StringFormat='{0} words'}"
                                    FontSize="12"
                                    TextColor="Gray" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Spacing="4"
                                    VerticalOptions="Center">
                                    <Button
                                        Style="{StaticResource NoBorderButton}"
                                        ImageSource="play.png"
                                        TextColor="White"
                                        BackgroundColor="{StaticResource Primary}"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ScriptListViewModel}}, Path=OpenPlayerCommand}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Play script in teleprompter" />
                                    <Label
                                        Text="{Binding UpdatedAt, StringFormat='{0:MMM d}'}"
                                        FontSize="12"
                                        TextColor="Gray"
                                        HorizontalOptions="Center" />
                                    <Button
                                        Style="{StaticResource NoBorderButton}"
                                        ImageSource="delete.png"
                                        TextColor="White"
                                        BackgroundColor="{AppThemeBinding Light=#FF3B30, Dark=#FF453A}"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        CornerRadius="14"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ScriptListViewModel}}, Path=DeleteScriptCommand}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Delete script" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="1"
            ImageSource="add.png"
            TextColor="White"
            BackgroundColor="{StaticResource Primary}"
            WidthRequest="56"
            HeightRequest="56"
            Padding="16"
            CornerRadius="28"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,16,24"
            Command="{Binding AddScriptCommand}"
            SemanticProperties.Description="Add new script" />
    </Grid>

</ContentPage>
